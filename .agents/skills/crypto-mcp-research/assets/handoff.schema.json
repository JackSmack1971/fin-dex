{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fin-dex.local/schemas/agent-handoff-v1.json",
  "title": "Fin-Dex Agent Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_id", "task_id", "status", "asset_scope", "claims", "observations", "conflicts", "coverage_gaps", "tool_calls"],
  "properties": {
    "schema_version": {"const": 1},
    "agent_id": {"enum": ["market_analyst", "liquidity_analyst", "onchain_analyst", "catalyst_analyst", "adversarial_reviewer", "evidence_verifier"]},
    "task_id": {"$ref": "#/$defs/id"},
    "status": {"enum": ["COMPLETE", "PARTIAL", "FAILED", "BLOCKED"]},
    "asset_scope": {"type": "array", "items": {"type": "object", "required": ["asset_id"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "chain_id": {"type": ["string", "integer"]}, "contract": {"type": "string"}, "instrument": {"type": "string"}}, "additionalProperties": false}},
    "claims": {"type": "array", "items": {"type": "object", "required": ["id", "statement", "status", "observation_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1}, "status": {"enum": ["CORROBORATED", "SINGLE_SOURCE", "CONFLICTED", "UNVERIFIED", "UNAVAILABLE"]}, "observation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}, "additionalProperties": false}},
    "observations": {"type": "array", "items": {"type": "object", "required": ["id", "source", "tool", "asset_id", "metric", "value", "unit", "observed_at_utc", "retrieved_at_utc"], "properties": {"id": {"$ref": "#/$defs/id"}, "source": {"type": "string", "minLength": 1}, "tool": {"type": "string", "minLength": 1}, "upstream_provenance": {"type": ["string", "null"]}, "asset_id": {"type": "string", "minLength": 1}, "venue": {"type": ["string", "null"]}, "metric": {"type": "string", "minLength": 1}, "value": {}, "unit": {"type": "string", "minLength": 1}, "observed_at_utc": {"type": "string", "format": "date-time"}, "retrieved_at_utc": {"type": "string", "format": "date-time"}, "methodology": {"type": ["string", "null"]}, "coverage": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "conflicts": {"type": "array", "items": {"type": "object", "required": ["id", "claim_ids", "description"], "properties": {"id": {"$ref": "#/$defs/id"}, "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "description": {"type": "string", "minLength": 1}, "resolution_test": {"type": "string"}}, "additionalProperties": false}},
    "coverage_gaps": {"type": "array", "items": {"type": "object", "required": ["id", "description"], "properties": {"id": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1}, "provider_status": {"enum": ["UNAVAILABLE", "UNVERIFIED"]}}, "additionalProperties": false}},
    "tool_calls": {"type": "array", "items": {"type": "object", "required": ["tool", "source", "outcome"], "properties": {"tool": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}, "outcome": {"enum": ["SUCCESS", "UNAVAILABLE", "ERROR", "NOT_CALLED"]}, "call_count": {"type": "integer", "minimum": 0}, "retrieved_at_utc": {"type": "string", "format": "date-time"}, "reason": {"type": "string"}}, "additionalProperties": false}},
    "review": {"type": "object", "required": ["synthesis_revision", "synthesis_sha256", "claim_ids"], "properties": {"synthesis_revision": {"$ref": "#/$defs/id"}, "synthesis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}, "additionalProperties": false}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
}
