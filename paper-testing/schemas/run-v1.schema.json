{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fin-dex.local/paper-testing/run-v1.schema.json",
  "title": "Paper execution run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "signal", "venue_evidence", "submission", "reconciliation", "evaluation"],
  "properties": {
    "schema_version": {"const": "paper-run.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PREPARED", "MODE_VERIFIED", "SUBMISSION_UNKNOWN", "ACKNOWLEDGED", "RECONCILED", "REJECTED"]},
    "signal": {"type": "object"},
    "venue_evidence": {"type": ["object", "null"]},
    "submission": {"type": ["object", "null"]},
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["order_id", "fills", "fees", "funding", "account_equity", "equity_history"],
      "properties": {
        "order_id": {"type": ["string", "null"]},
        "fills": {"type": ["array", "null"]},
        "fees": {"type": ["number", "null"]},
        "funding": {"type": ["number", "null"]},
        "account_equity": {"type": ["number", "null"]},
        "equity_history": {"type": ["array", "null"]}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "missing_fields", "metrics"],
      "properties": {
        "complete": {"type": "boolean"},
        "missing_fields": {"type": "array", "items": {"type": "string"}},
        "metrics": {"type": ["object", "null"]}
      }
    }
  }
}
